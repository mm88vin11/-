{
  "name": "baza-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "БАЗА — production build. Vite + TypeScript, one ticker, twelve worlds, shader seams.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && SINGLE=1 vite build --outDir dist-single",
    "preview": "vite preview --port 4173 --strictPort",
    "assets": "node scripts/build-assets.mjs",
    "qa": "node qa/run.mjs",
    "guard": "node scripts/perf-guard.mjs",
    "qa:a11y": "node qa/a11y.mjs",
    "qa:loader": "node qa/loader.mjs",
    "qa:lh": "node qa/lighthouse.mjs",
    "qa:all": "node qa/run.mjs && node qa/a11y.mjs && node qa/loader.mjs && node qa/lighthouse.mjs",
    "assets:single": "node scripts/build-single-reel.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "matter-js": "^0.20.0",
    "ogl": "^1.0.11",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.5.0",
    "@types/three": "^0.185.4",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
